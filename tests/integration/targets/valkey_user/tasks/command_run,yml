---
- name: Alter user to target state {{ _test_case.name }}
  rkozlo.valkey.valkey_user:
    name: "{{ _test_case.name | default(omit) }}"
    enabled: "{{ _test_case.enable | default(omit) }}"
    passwords: "{{ _test_case.passwords | default(omit) }}"
    hashed_passwords: "{{ _test_case.hashed_passwords | default(omit) }}"
    commands: "{{ _test_case.commands | default(omit) }}"
    keys: "{{ _test_case.keys | default(omit) }}"
    channels: "{{ _test_case.channels | default(omit) }}"
    selectors: "{{ _test_case.selectors | default(omit) }}"
    categories: "{{ _test_case.categories | default(omit) }}"
    append_passwords: "{{ _test_case.append_passwords | default(omit) }}"
    append_keys: "{{ _test_case.append_keys | default(omit) }}"
    append_channels: "{{ _test_case.append_channels | default(omit) }}"
  register: result

- name: Check the return values {{ _test_case.name }}
  ansible.builtin.assert:
    that:
      - result.changed == true
      - result.executed_statements[0] == _test_case.__expected_alter

- name: Alter user to target state {{ _test_case.name }} - idempotency
  rkozlo.valkey.valkey_user:
    name: "{{ _test_case.name | default(omit) }}"
    enabled: "{{ _test_case.enable | default(omit) }}"
    passwords: "{{ _test_case.passwords | default(omit) }}"
    hashed_passwords: "{{ _test_case.hashed_passwords | default(omit) }}"
    commands: "{{ _test_case.commands | default(omit) }}"
    keys: "{{ _test_case.keys | default(omit) }}"
    channels: "{{ _test_case.channels | default(omit) }}"
    selectors: "{{ _test_case.selectors | default(omit) }}"
    categories: "{{ _test_case.categories | default(omit) }}"
    append_passwords: "{{ _test_case.append_passwords | default(omit) }}"
    append_keys: "{{ _test_case.append_keys | default(omit) }}"
    append_channels: "{{ _test_case.append_channels | default(omit) }}"
  register: result

- name: Check the return values {{ _test_case.name }}
  ansible.builtin.assert:
    that:
      - result.changed == false
      - result.executed_statements == []

- name: Check user is dropped
  rkozlo.valkey.valkey_exec:
    command: "{{  _test_case.name }}"
    params:
      username: test_user
  register: result

- name: Drop user {{ _test_case.name }}
  rkozlo.valkey.valkey_user:
    name: "{{ _test_case.name }}"
    state: absent
  register: result